{
  "name": "Controladoria PNCP",
  "dataColors": ["#1F4E79", "#2E86AB", "#F18F01", "#6C757D", "#A23B72", "#3B8B5A", "#C73E1D", "#9AA5B1"],
  "background": "#FFFFFF",
  "foreground": "#1B2631",
  "tableAccent": "#1F4E79",
  "good": "#3B8B5A",
  "neutral": "#F18F01",
  "bad": "#C73E1D",
  "maximum": "#1F4E79",
  "center": "#DCE6F0",
  "minimum": "#F4F7FA",
  "textClasses": {
    "title":  { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1B2631" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B2631" },
    "label":  { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5D6D7E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F4E79" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E8EC" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    }
  }
}
